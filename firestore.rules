rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email == 'thewildscapes@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Timetables / Routine
    match /timetables/{docId} {
      allow read, write: if true;
    }

    // Routine Versioning & Rollback History
    match /routineVersions/{versionId} {
      allow read, write: if true;
    }

    // Automated & Manual Backups
    match /routineBackups/{backupId} {
      allow read, write: if true;
    }

    // Raw Routine Files (Excel / CSV original files)
    match /routineRawFiles/{fileId} {
      allow read, write: if true;
    }

    // Faculty Roster
    match /faculty/{facId} {
      allow read, write: if true;
    }

    // Rooms Directory
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // Faculty Self-Import Records
    match /faculty_self_imports/{recordId} {
      allow read, write: if true;
    }

    // QR Code Student Self-Enrollment Sessions
    match /qr_enrollment_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Student Enrollment Submissions (Public read & create for scanning students)
    match /student_enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // Master Student Roster
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Calendar Events
    match /calendarEvents/{eventId} {
      allow read, write: if true;
    }

    // Class Diary Entries with cross-device sync and offline durability
    match /classDiary/{entryId} {
      allow read, write: if true;
    }

    // Admin & Timetable Uploads
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
