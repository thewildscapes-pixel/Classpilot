rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email == 'thewildscapes@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Timetables / Routine
    match /timetables/{docId} {
      allow read, write: if true;
    }

    // Routine Versioning & Rollback History
    match /routineVersions/{versionId} {
      allow read, write: if true;
    }

    // Automated & Manual Backups
    match /routineBackups/{backupId} {
      allow read, write: if true;
    }

    // Raw Routine Files (Excel / CSV original files)
    match /routineRawFiles/{fileId} {
      allow read, write: if true;
    }

    // Faculty Roster
    match /faculty/{facId} {
      allow read, write: if true;
    }

    // Rooms Directory
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // Faculty Self-Import Records
    match /faculty_self_imports/{recordId} {
      allow read, write: if true;
    }

    // QR Code Student Self-Enrollment Sessions
    match /qr_enrollment_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Student Enrollment Submissions (Public read & create for scanning students)
    match /student_enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // Master Student Roster
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Calendar Events
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Class Diary Entries with 24-hour edit lock based on request.time or serverTimestamp
    match /classDiary/{entryId} {
      allow read: if isAuthenticated();
      
      // Allow create if user is owner or admin
      allow create: if isAuthenticated() && 
        (request.resource.data.facultyId == request.auth.uid || request.resource.data.facultyEmail == request.auth.email || isAdmin());

      // Allow update/delete within 24 hours of creation timestamp
      allow update, delete: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.facultyId == request.auth.uid || resource.data.facultyEmail == request.auth.email) &&
          (resource.data.createdAt == null || request.time < resource.data.createdAt + duration.value(24, 'h'))
        )
      );
    }

    // Admin & Timetable Uploads
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
